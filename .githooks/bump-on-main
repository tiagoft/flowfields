#!/bin/sh
# Bump the patch version in every commit that lands on main.
# Called by pre-commit (direct commits, merges that stopped on conflicts)
# and pre-merge-commit (git merge --no-ff), whose bump post-merge folds into
# the merge commit.

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[ "$branch" = main ] || exit 0

FILES="pyproject.toml uv.lock js/package.json js/package-lock.json"

# shellcheck disable=SC2086  # FILES is a list of paths
if ! git diff --quiet -- $FILES; then
    echo "bump-on-main: one of $FILES has unstaged changes;" >&2
    echo "stage or discard them before committing on main." >&2
    exit 1
fi

python3 tools/bump_version.py || exit 1
# shellcheck disable=SC2086
git add $FILES
