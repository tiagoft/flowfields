#!/bin/sh
# git merge does not put changes staged by pre-merge-commit into the merge
# commit, so the version bump is still in the index here: fold it in.
# Fast-forward pulls never run pre-merge-commit, so nothing is staged then.
#
# git still counts the merge as in progress while this hook runs and refuses
# `commit --amend`, so the merge commit is rebuilt with plumbing: same
# parents, author and message, with the index as its tree.

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[ "$branch" = main ] || exit 0
git rev-parse --quiet --verify HEAD^2 >/dev/null || exit 0
git diff --cached --quiet -- pyproject.toml uv.lock js/package.json js/package-lock.json && exit 0

tree=$(git write-tree) || exit 1
parents=$(git rev-parse HEAD^@ | sed 's/^/-p /')
GIT_AUTHOR_NAME=$(git log -1 --format=%an HEAD)
GIT_AUTHOR_EMAIL=$(git log -1 --format=%ae HEAD)
GIT_AUTHOR_DATE=$(git log -1 --format=%ad --date=raw HEAD)
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE
# shellcheck disable=SC2086  # $parents must split into -p <sha> pairs
commit=$(git log -1 --format=%B HEAD | git commit-tree "$tree" $parents) || exit 1
git update-ref -m "post-merge: version bump" HEAD "$commit" HEAD
